{
  "name": "@motorical/mcp",
  "version": "1.9.1",
  "description": "MCP server for Motorical transactional email API — dry-run/send, mint public tokens, list Motor Blocks, inspect delivery events",
  "type": "module",
  "bin": {
    "motorical-mcp": "./src/index.js"
  },
  "main": "./src/server.js",
  "exports": {
    ".": "./src/server.js",
    "./client": "./src/client.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "serve": "node src/serve.js",
    "test": "node --test test/*.test.js",
    "smoke": "node test/live-smoke.js",
    "emit-catalogue": "node scripts/emit-catalogue.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "motorical",
    "mcp",
    "email",
    "smtp",
    "transactional-email",
    "email-api",
    "model-context-protocol"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@motorical/scope-catalog": "^0.2.0",
    "express": "^4.22.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.25.0"
  },
  "files": [
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://docs.motorical.com/ai-mcp",
  "bugs": {
    "url": "https://github.com/motorical-smtp/motorical-packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/motorical-smtp/motorical-packages.git",
    "directory": "packages/motorical-mcp"
  },
  "devDependencies": {
    "pg": "^8.23.0",
    "supertest": "^7.2.2"
  }
}
